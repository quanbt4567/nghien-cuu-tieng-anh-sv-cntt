# Neon Postgres (Primary database; app degrades gracefully to localStorage when omitted)
DATABASE_URL=

# Supabase Configuration (Optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin & Cron Security
ADMIN_PASSCODE=
ADMIN_SESSION_SECRET=
CRON_SECRET=

# AI Providers Waterfall (Optional - user can also enter Gemini key in /settings)
# NEVER commit .env.local to source control!
GEMINI_API_KEY=
CEREBRAS_API_KEY=
INCEPTION_API_KEY=
GROQ_API_KEY=
XKIRO_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

